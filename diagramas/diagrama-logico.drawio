        <mxCell id="1" parent="0"/>
        <mxCell id="leyenda" value="&lt;b&gt;Kit móvil de salud · diagrama lógico (v0.4)&lt;/b&gt;&lt;br&gt;Todo el tráfico entre redes pasa por nftables en kit01&lt;br&gt;Política por defecto: denegar y registrar (IPv4 e IPv6)&lt;br&gt;ULA fd5a:fc7e:d716::/48 · gateway .1 / fe80::1 en cada red interna" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
