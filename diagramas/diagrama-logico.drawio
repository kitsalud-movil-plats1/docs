        <mxCell id="nucleo" value="&lt;b&gt;Núcleo de red (servicios systemd)&lt;/b&gt;&lt;br&gt;• nftables: filtro inet IPv4/IPv6 + NAT IPv4&lt;br&gt;• Kea DHCPv4 (pools y reservas) y DHCPv6 stateless&lt;br&gt;• radvd: SLAAC con M=0, O=1, sin RDNSS&lt;br&gt;• BIND9: zona salud.movil (A, AAAA, PTR)&lt;br&gt;• Chrony: ntp.salud.movil&lt;br&gt;• Portal cautivo: nginx + set de MAC (8 h)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="45" y="245" width="440" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="zonas" value="&lt;b&gt;Zonas de nftables&lt;/b&gt;&lt;br&gt;wan0 · lan0.10 Interna · lan0.40 Comunidad&lt;br&gt;br-srv Servidores · wt0 NetBird&lt;br&gt;La familia bridge filtra también entre las VMs&lt;br&gt;Gestión (SSH, GUIs): solo admin .10-.29 y wt0" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
