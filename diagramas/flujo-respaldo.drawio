<mxfile host="drawio"><diagram id="Flujo del respaldo" name="Flujo del respaldo"><mxGraphModel dx="1500" dy="720" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="720" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;clinica01&lt;/b&gt; · datos clínicos y dominio" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;strokeWidth=2;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="400" height="470" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Recursos compartidos&lt;/b&gt;&lt;br&gt;archivos y contenido, con ACL&lt;br&gt;rsync de solo lectura" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;strokeWidth=1;spacingLeft=80;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="360" height="80" as="geometry"/></mxCell><mxCell id="c3" value="" style="image;aspect=fixed;imageAspect=1;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="50" y="92" width="70" height="36" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Bases de datos&lt;/b&gt;&lt;br&gt;dhis2 y prerregistro, y los roles&lt;br&gt;pg_dump en formato propio" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;strokeWidth=1;spacingLeft=80;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="360" height="80" as="geometry"/></mxCell><mxCell id="c5" value="" style="image;aspect=fixed;imageAspect=1;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="62" y="182" width="46" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Dominio ad.salud.movil&lt;/b&gt;&lt;br&gt;samba-tool domain backup offline" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;strokeWidth=1;spacingLeft=80;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="360" height="80" as="geometry"/></mxCell><mxCell id="c7" value="" style="image;aspect=fixed;imageAspect=1;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="50" y="292" width="70" height="36" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Configuración&lt;/b&gt;&lt;br&gt;/etc y /srv sin los datos grandes&lt;br&gt;(Compose, .env, Caddy, DHIS2)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;strokeWidth=1;spacingLeft=80;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="360" height="80" as="geometry"/></mxCell><mxCell id="c9" value="" style="image;aspect=fixed;imageAspect=1;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="52" y="385" width="60" height="46" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;comunidad01&lt;/b&gt; · servicios para la comunidad" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontFamily=Helvetica;strokeWidth=2;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="400" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Configuración&lt;/b&gt;&lt;br&gt;/etc y /srv (Compose, Caddy, Jellyfin)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;strokeWidth=1;spacingLeft=80;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="360" height="64" as="geometry"/></mxCell><mxCell id="c12" value="" style="image;aspect=fixed;imageAspect=1;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="52" y="570" width="56" height="42" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="20" width="560" height="620" as="geometry"/></mxCell><mxCell id="c14" value="" style="image;aspect=fixed;imageAspect=1;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="576" y="32" width="22" height="32" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;kit01&lt;/b&gt; · extrae, cifra y guarda" style="text;html=1;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;strokeColor=none;fillColor=none;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="606" y="30" width="500" height="36" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Domingo a las 4:00&lt;/b&gt; (backup.timer) o copia manual&lt;br&gt;antes de cada cambio y al cerrar cada misión" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="500" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Área temporal&lt;/b&gt; /var/lib/kitsalud/backup&lt;br&gt;Solo se transfiere lo que cambió. Se suma el /etc de kit01, con la raíz de la CA del kit" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="590" y="200" width="500" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;restic&lt;/b&gt;&lt;br&gt;Un snapshot por tipo (config, recursos, bd, dominio)&lt;br&gt;Cifrado AES-256 y deduplicado&lt;br&gt;restic check al final de cada copia&lt;br&gt;Clave en /etc/kitsalud/backup, solo root" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;strokeWidth=1;spacingLeft=120;" vertex="1" parent="1"><mxGeometry x="590" y="330" width="500" height="150" as="geometry"/></mxCell><mxCell id="c19" value="" style="image;aspect=fixed;imageAspect=1;image=data:image/png," vertex="1" parent="1"><mxGeometry x="610" y="355" width="100" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Si la copia falla&lt;/b&gt;&lt;br&gt;El servicio termina con error y el tablero Estado del kit lo muestra como unidad fallida" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;strokeWidth=1;spacingLeft=70;" vertex="1" parent="1"><mxGeometry x="590" y="520" width="500" height="90" as="geometry"/></mxCell><mxCell id="c21" value="" style="image;aspect=fixed;imageAspect=1;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="606" y="545" width="40" height="40" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Disco USB&lt;/b&gt;&lt;br&gt;500 GB, ext4&lt;br&gt;&lt;br&gt;Repositorio restic cifrado&lt;br&gt;4 copias semanales y&lt;br&gt;3 mensuales por tipo" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Helvetica;strokeWidth=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;" vertex="1" parent="1"><mxGeometry x="1240" y="295" width="240" height="220" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Máquina de control&lt;/b&gt;&lt;br&gt;La clave de restic vive cifrada en el vault de Ansible, una copia fuera del kit" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;strokeWidth=1;spacingLeft=56;" vertex="1" parent="1"><mxGeometry x="1200" y="540" width="280" height="100" as="geometry"/></mxCell><mxCell id="c24" value="" style="image;aspect=fixed;imageAspect=1;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="1212" y="572" width="36" height="36" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#2e7d32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="110"/><mxPoint x="480" y="245"/></Array></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#2e7d32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="210"/><mxPoint x="480" y="245"/></Array></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#2e7d32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="310"/><mxPoint x="480" y="245"/></Array></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#2e7d32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="410"/><mxPoint x="480" y="245"/></Array></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#2e7d32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="592"/><mxPoint x="480" y="245"/></Array></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#555555;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#555555;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="Montado solo&lt;br&gt;durante la copia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#2e7d32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="Ansible instala&lt;br&gt;la clave" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=11;fontFamily=Helvetica;fontColor=#555555;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="590"/><mxPoint x="1150" y="457"/></Array></mxGeometry></mxCell><mxCell id="c34" value="kit01 entra a cada VM por SSH con el usuario backup, que solo acepta un comando de extracción de solo lectura. El disco se monta con noexec, nodev y nosuid y se desmonta al terminar, también si algo falla.&lt;br&gt;Las VMs nunca envían datos por su cuenta y no tienen la clave del repositorio ni llaves hacia kit01, así que una VM comprometida no puede leer ni borrar las copias." style="text;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1460" height="50" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Copia en línea&lt;/b&gt; (diseñada, sin implementar)&lt;br&gt;rest-server en un servidor de la organización&lt;br&gt;Solo agregar, cifrada desde kit01&lt;br&gt;HTTPS, solo cuando hay Internet" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;dashed=1;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="280" height="110" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;dashed=1;endArrow=block;endFill=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
